# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/dbname

# Groq Cloud API key for LLaMA 3.3
GROQ_API_KEY=gsk_...

# Google Gemini API key (alternative/additional AI model)
GEMINI_API_KEY=AIzaSy...

# JWT Token Signing Secret (use a secure random string)
JWT_SECRET=your_jwt_secret_here

# Express Server Port (defaults to 5000 if not set)
PORT=5000

# Optional: Render API Key for deployment triggers
# RENDER_API_KEY=rnd_...
